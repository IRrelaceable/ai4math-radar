# --- Database (PostgreSQL) -------------------------------------------------
# Leave DATABASE_URL unset to run the site on the bundled demo dataset
# (no database required). Set it to switch the data layer to Prisma/PostgreSQL.
#
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai4math?schema=public"

# --- LLM API (optional,预留接口) -------------------------------------------
# provider: mock (default, offline) | openai-compatible
LLM_PROVIDER=mock
# LLM_API_URL="https://api.openai.com/v1/chat/completions"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"

# --- Next.js ---------------------------------------------------------------
PORT=3000
