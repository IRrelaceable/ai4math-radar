# --- LLM API (used by `npm run sync` to summarize ingested items) ----------
# provider: mock (default, offline) | openai-compatible
LLM_PROVIDER=mock
# LLM_API_URL="https://api.openai.com/v1/chat/completions"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"

# --- Build -----------------------------------------------------------------
# Sub-path the site is served from: "/<repo>" for a GitHub project page,
# empty for a user page or custom domain. `npm run build:site` reads it.
# SITE_BASE=/ai4math-radar

# --- Next.js (dev server) --------------------------------------------------
PORT=3000

# --- Database (optional, only for local Prisma experiments) -----------------
# The published site is a static export built from data/seed + data/ingested.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai4math?schema=public"
