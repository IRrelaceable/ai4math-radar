.i18n-src/

# local working notes (requirements draft), not source
文本.txt

# oil-ui design-session working artifacts
.oil-ui/

# local verification scratch (headless browser captures and probes)
.edge-verify/

# local agent working notes
.workbuddy/

# NOTE: data/ingested/*.json IS committed — the scheduled GitHub Actions job
