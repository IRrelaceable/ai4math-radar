# Normalize line endings: LF in the repository, regardless of platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF so cmd.exe parses them correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
