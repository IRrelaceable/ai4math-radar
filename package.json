{
  "name": "ai4math-research-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "AI4Math Ecosystem Radar - a five-class ecosystem intelligence platform for AI for Mathematics.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:en": "node scripts/dev-en.mjs",
    "sync:server": "node scripts/sync-server.mjs",
    "predev": "npm run data",
    "build": "next build",
    "prebuild": "npm run data",
    "data": "tsx scripts/build-data.ts",
    "sync": "tsx scripts/ingest.ts",
    "sync:all": "tsx scripts/ingest.ts --all",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "build:site": "node scripts/build-site.mjs",
    "backfill:entities": "tsx scripts/backfill-entities.ts",
    "backfill:citations": "tsx scripts/backfill-citations.ts",
    "backfill:direction": "tsx scripts/backfill-direction.ts",
    "audit:direction": "tsx scripts/audit-direction.ts",
    "apply:direction": "tsx scripts/apply-direction-audit.ts",
    "backfill:history:conf": "tsx scripts/backfill-history-conference.ts",
    "backfill:history": "tsx scripts/backfill-history.ts",
    "audit:direction:source": "tsx scripts/audit-direction-source.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
